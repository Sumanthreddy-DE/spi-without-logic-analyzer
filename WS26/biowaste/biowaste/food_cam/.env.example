# Copy to ".env" (same folder) and fill in. .env is never committed.

# Option A: Anthropic API key (api.anthropic.com)
ANTHROPIC_API_KEY=paste-your-key-here

# Option B: custom endpoint - comment out option A and use these instead
# ANTHROPIC_BASE_URL=https://api.dlabkeys.com
# ANTHROPIC_AUTH_TOKEN=paste-your-key-here

# optional: FOOD_CAM_MODEL=claude-haiku-4-5-20251001
